rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Paste the two UIDs from Firebase Console → Authentication → Users (same as js/config.js).
    function isAdmin() { return request.auth != null && request.auth.uid == "QFJRZvqHsAY7IUSCcVJS6yhF4Di2"; }
    function isHer()   { return request.auth != null && request.auth.uid == "XTR9TcajnTXxx4AM7lo5VwzCZWQ2"; }

    match /wishlists/{listId} {
      // Only her account can send, and only a list in the exact expected shape.
      allow create: if isHer()
        && request.resource.data.keys().hasOnly(['items', 'images', 'note', 'by', 'sentAt'])
        && request.resource.data.keys().hasAll(['items', 'note', 'by', 'sentAt'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.sentAt == request.time
        && request.resource.data.items is list
        && request.resource.data.items.size() >= 1
        && request.resource.data.items.size() <= 50
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 300
        && (!('images' in request.resource.data)
            || (request.resource.data.images is list && request.resource.data.images.size() <= 50));

      // You read and delete everything; she can read only the lists she sent (to see what glows).
      allow read: if isAdmin() || (isHer() && resource.data.by == request.auth.uid);
      allow delete: if isAdmin();

      // You can only change the "bought" ticks — never her words.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bought'])
        && request.resource.data.bought is list
        && request.resource.data.bought.size() <= 50;
    }

    // Photos: only she uploads (JPEG/WebP data, size-capped), nothing can be edited,
    // only you and she can open one by its id, and nobody can list them.
    match /images/{imgId} {
      allow create: if isHer()
        && request.resource.data.keys().hasOnly(['data', 'by', 'createdAt'])
        && request.resource.data.keys().hasAll(['data', 'by', 'createdAt'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 750000
        && request.resource.data.data.matches('data:image/(jpeg|webp);base64,[A-Za-z0-9+/=]+');
      allow get: if isAdmin() || (isHer() && resource.data.by == request.auth.uid);
      allow delete: if isAdmin() || (isHer() && resource.data.by == request.auth.uid);
    }

    // Everything else: closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
